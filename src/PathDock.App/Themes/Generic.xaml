<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                    xmlns:local="clr-namespace:PathDock.App.Controls">

    <!-- 공용 수치: 모서리 반경을 한 곳에서 관리한다. 각진 인상을 위해 2px(거의 직각)로 통일. -->
    <CornerRadius x:Key="PdCardRadius">2</CornerRadius>

    <!-- ============ PanelCard: 아이콘+제목 머리글이 있는 각진 카드 ============ -->
    <Style TargetType="{x:Type local:PanelCard}">
        <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ControlStrongStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:PanelCard}">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource PdCardRadius}"
                            SnapsToDevicePixels="True">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!-- 머리글: 색이 다른 띠 + 아래 구분선 -->
                            <Border x:Name="HeaderBar" Padding="10,6"
                                    Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                    BorderBrush="{DynamicResource ControlStrongStrokeColorDefaultBrush}"
                                    BorderThickness="0,0,0,1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ui:SymbolIcon x:Name="HeaderIcon" Grid.Column="0" Margin="0,0,7,0" FontSize="14"
                                                   Symbol="{TemplateBinding Symbol}"
                                                   Foreground="{DynamicResource SystemAccentColorPrimaryBrush}" />
                                    <TextBlock Grid.Column="1" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="{DynamicResource PdFontSize}"
                                               Text="{TemplateBinding Header}" TextTrimming="CharacterEllipsis" />
                                    <ContentPresenter Grid.Column="2" VerticalAlignment="Center"
                                                      Content="{TemplateBinding HeaderTrailing}" />
                                </Grid>
                            </Border>

                            <ContentPresenter Grid.Row="1" Margin="{TemplateBinding ContentPadding}" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Header" Value="{x:Null}">
                            <Setter TargetName="HeaderBar" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Symbol" Value="Empty">
                            <Setter TargetName="HeaderIcon" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ UsageMeter: 라벨 + 막대 + 값 ============ -->
    <Style TargetType="{x:Type local:UsageMeter}">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Margin" Value="14,0,0,0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:UsageMeter}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Margin="0,0,6,0" VerticalAlignment="Center" FontSize="{DynamicResource PdFontSizeSmall}" FontWeight="SemiBold"
                                   Text="{TemplateBinding Label}"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <ProgressBar x:Name="Bar" Width="56" Height="5" VerticalAlignment="Center"
                                     Minimum="0" Maximum="100" Value="{TemplateBinding Value}" />
                        <TextBlock Margin="7,0,0,0" MinWidth="38" VerticalAlignment="Center" FontSize="{DynamicResource PdFontSizeSmall}"
                                   Text="{TemplateBinding ValueText}" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsWarning" Value="True">
                            <Setter TargetName="Bar" Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                        </Trigger>
                        <Trigger Property="IsAvailable" Value="False">
                            <Setter TargetName="Bar" Property="Opacity" Value="0.35" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ DriveCard: 드라이브 한 칸 ============ -->
    <Style TargetType="{x:Type local:DriveCard}">
        <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ControlStrongStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="True" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Margin" Value="0,0,0,6" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:DriveCard}">
                    <Border x:Name="Root" Padding="10,8"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource PdCardRadius}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Margin="0,0,7,0" FontSize="16" Symbol="{TemplateBinding Symbol}"
                                               Foreground="{DynamicResource SystemAccentColorPrimaryBrush}" />
                                <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" FontSize="{DynamicResource PdFontSize}"
                                           Text="{TemplateBinding Title}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <ProgressBar x:Name="Bar" Height="5" Margin="0,7,0,4" Minimum="0" Maximum="100"
                                         Value="{TemplateBinding UsedPercent}" />
                            <TextBlock FontSize="{DynamicResource PdFontSizeSmall}" TextWrapping="Wrap" Text="{TemplateBinding Detail}"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource SystemAccentColorPrimaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsCurrent" Value="True">
                            <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource SystemAccentColorPrimaryBrush}" />
                            <Setter TargetName="Root" Property="BorderThickness" Value="2" />
                            <Setter TargetName="Root" Property="Padding" Value="9,7" />
                        </Trigger>
                        <Trigger Property="IsLow" Value="True">
                            <Setter TargetName="Bar" Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="Opacity" Value="0.85" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ FavoriteChip: 번호 배지 + 이름 (각진 태그 모양) ============ -->
    <Style TargetType="{x:Type local:FavoriteChip}">
        <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ControlStrongStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Margin" Value="0,0,6,0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:FavoriteChip}">
                    <Border x:Name="Root" Padding="3,3,10,3" CornerRadius="{StaticResource PdCardRadius}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <StackPanel Orientation="Horizontal">
                            <Border x:Name="Badge" MinWidth="18" MinHeight="18" Padding="3,0" CornerRadius="{StaticResource PdCardRadius}"
                                    Background="{DynamicResource SystemAccentColorPrimaryBrush}">
                                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="{DynamicResource PdFontSizeSmall}"
                                           FontWeight="SemiBold" Text="{Binding Index, RelativeSource={RelativeSource TemplatedParent}}"
                                           Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                            </Border>
                            <ui:SymbolIcon x:Name="Glyph" Margin="7,0,4,0" FontSize="14" Symbol="Folder24"
                                           Foreground="{DynamicResource SystemAccentColorPrimaryBrush}" />
                            <TextBlock x:Name="Label" MaxWidth="170" VerticalAlignment="Center" FontSize="{DynamicResource PdFontSize}"
                                       Text="{TemplateBinding Title}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="Opacity" Value="0.85" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource SystemAccentColorPrimaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsEmpty" Value="True">
                            <Setter TargetName="Badge" Property="Background" Value="{DynamicResource ControlStrongStrokeColorDefaultBrush}" />
                            <Setter TargetName="Glyph" Property="Symbol" Value="Add24" />
                            <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
                            <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ AddressBar: 아이콘 + 경로 입력. 배경/테두리는 바깥 Border 하나만 쓴다(이중 배경 방지). ============ -->
    <Style TargetType="{x:Type local:AddressBar}">
        <Setter Property="Background" Value="{DynamicResource PdAddressBarBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PdAddressBarBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontSize" Value="{DynamicResource PdFontSizeLarge}" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:AddressBar}">
                    <Border x:Name="Root" Padding="10,0,6,0" MinHeight="32"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource PdCardRadius}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ui:SymbolIcon Margin="0,0,8,0" FontSize="16" Symbol="{TemplateBinding Symbol}"
                                           Foreground="{DynamicResource SystemAccentColorPrimaryBrush}" />
                            <!-- 순수 입력칸: 자체 템플릿을 ScrollViewer 하나로 줄여 배경/테두리를 그리지 않는다. -->
                            <TextBox x:Name="PART_TextBox" Grid.Column="1" VerticalAlignment="Center"
                                     VerticalContentAlignment="Center"
                                     Background="Transparent" BorderThickness="0" Padding="0"
                                     FontSize="{TemplateBinding FontSize}"
                                     FontFamily="{DynamicResource PdFontFamily}"
                                     Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                     CaretBrush="{DynamicResource TextFillColorPrimaryBrush}"
                                     SelectionBrush="{DynamicResource SystemAccentColorPrimaryBrush}"
                                     AutomationProperties.AutomationId="{Binding TextBoxAutomationId, RelativeSource={RelativeSource TemplatedParent}}"
                                     AutomationProperties.Name="{Binding TextBoxAutomationName, RelativeSource={RelativeSource TemplatedParent}}"
                                     Text="{Binding Text, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                <TextBox.Template>
                                    <ControlTemplate TargetType="{x:Type TextBox}">
                                        <ScrollViewer x:Name="PART_ContentHost" Focusable="False"
                                                      HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" />
                                    </ControlTemplate>
                                </TextBox.Template>
                            </TextBox>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource SystemAccentColorPrimaryBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
