<UserControl x:Class="PathDock.App.Views.FavoritesBarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:PathDock.App.Controls"
             xmlns:vm="clr-namespace:PathDock.App.ViewModels">
    <!-- 즐겨찾기 10칸. 클릭=이동(빈 칸이면 현재 폴더 등록), 우클릭=등록/비우기. DataContext: MainViewModel -->
    <!-- Tab은 칸 전체를 한 번에 지나가고, 칸 사이는 방향키로 옮긴다(10칸을 모두 Tab으로 거치지 않게) -->
    <ItemsControl ItemsSource="{Binding Favorites}" AutomationProperties.AutomationId="FavoritesBar" Focusable="False"
                  KeyboardNavigation.TabNavigation="Once" KeyboardNavigation.DirectionalNavigation="Cycle">
        <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
                <!-- 한 줄에 다 들어가면 10칸, 아니면 5칸씩 두 줄(10번째 칸만 홀로 넘어가지 않게). 열 수는 코드 숨김에서 정한다 -->
                <UniformGrid Columns="10" Loaded="OnPanelLoaded" />
            </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
            <DataTemplate DataType="{x:Type vm:FavoriteSlotViewModel}">
                <ctl:FavoriteChip Index="{Binding Index}"
                                  Title="{Binding DisplayName}"
                                  IsEmpty="{Binding IsEmpty}"
                                  Command="{Binding ClickCommand}"
                                  AutomationProperties.AutomationId="{Binding AutomationId}"
                                  AutomationProperties.Name="{Binding Caption}">
                    <ctl:FavoriteChip.ToolTip>
                        <ToolTip FontFamily="{StaticResource PdFontFamily}" Content="{Binding ToolTipText}" />
                    </ctl:FavoriteChip.ToolTip>
                    <ctl:FavoriteChip.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="현재 폴더를 이 칸에 등록" Command="{Binding RegisterHereCommand}" />
                            <MenuItem Header="이름 바꾸기..." Command="{Binding RenameCommand}" />
                            <MenuItem Header="왼쪽으로 이동" Command="{Binding MoveLeftCommand}" />
                            <MenuItem Header="오른쪽으로 이동" Command="{Binding MoveRightCommand}" />
                            <Separator />
                            <MenuItem Header="이 칸 비우기" Command="{Binding ClearCommand}" />
                        </ContextMenu>
                    </ctl:FavoriteChip.ContextMenu>
                </ctl:FavoriteChip>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>
</UserControl>
