<UserControl x:Class="PathDock.App.Views.TerminalPanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:PathDock.App.Localization"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:ctl="clr-namespace:PathDock.App.Controls">
    <!-- 터미널 패널: 머리글 오른쪽에 셸 상태와 접기/펼치기 버튼. DataContext: TerminalViewModel -->
    <ctl:PanelCard Header="{Binding Header}" Symbol="WindowConsole20">
        <ctl:PanelCard.HeaderTrailing>
            <StackPanel Orientation="Horizontal">
                <TextBlock FontSize="{DynamicResource PdFontSize}" Text="{Binding StatusText}" VerticalAlignment="Center"
                           AutomationProperties.AutomationId="TerminalStatus"
                           AutomationProperties.Name="{Binding StatusText}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                            <Style.Triggers>
                                <!-- 이동이 보류 중이면 강조색 + 굵게: 탐색기와 터미널 경로가 다른 이유를 알려 준다 -->
                                <DataTrigger Binding="{Binding IsPending}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <ui:SymbolIcon Symbol="QuestionCircle24" FontSize="14" Margin="10,0,2,0" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               ToolTip="{loc:T '마우스 드래그: 글자 선택 (더블클릭: 단어)&#x0A;Ctrl+C: 선택이 있으면 복사, 없으면 실행 중단&#x0A;Ctrl+Shift+C: 복사&#x0A;Ctrl+V: 붙여넣기&#x0A;우클릭: 선택이 있으면 복사, 없으면 붙여넣기&#x0A;휠: 지난 출력 보기', 'Mouse drag: select text (double-click: word)&#x0A;Ctrl+C: copy if there is a selection, otherwise interrupt&#x0A;Ctrl+Shift+C: copy&#x0A;Ctrl+V: paste&#x0A;Right-click: copy if there is a selection, otherwise paste&#x0A;Wheel: scroll back through output'}"
                               AutomationProperties.AutomationId="TerminalHelp" AutomationProperties.Name="{loc:T '터미널 사용법', 'Terminal help'}" />
                <ui:Button Appearance="Transparent" Margin="4,-3,0,-3" Padding="6,3"
                           Command="{Binding ClearScreenCommand}" Click="OnClearClick"
                           ToolTip="{loc:T '터미널 화면 지우기', 'Clear terminal screen'}"
                           AutomationProperties.AutomationId="TerminalClearButton"
                           AutomationProperties.Name="{loc:T '터미널 화면 지우기', 'Clear terminal screen'}">
                    <ui:SymbolIcon Symbol="Eraser24" FontSize="14" />
                </ui:Button>
                <ui:Button Appearance="Transparent" Margin="2,-3,0,-3" Padding="6,3"
                           Command="{Binding SaveOutputCommand}"
                           ToolTip="{loc:T '터미널 내용을 파일로 저장', 'Save terminal contents to a file'}"
                           AutomationProperties.AutomationId="TerminalSaveButton"
                           AutomationProperties.Name="{loc:T '터미널 내용 저장', 'Save terminal contents'}">
                    <ui:SymbolIcon Symbol="Save24" FontSize="14" />
                </ui:Button>
                <ui:Button Appearance="Transparent" Margin="2,-3,-6,-3" Padding="6,3"
                           Command="{Binding ToggleCollapsedCommand}"
                           ToolTip="{Binding CollapseToolTip}"
                           AutomationProperties.AutomationId="TerminalCollapseButton"
                           AutomationProperties.Name="{Binding CollapseToolTip}">
                    <ui:SymbolIcon FontSize="14">
                        <ui:SymbolIcon.Style>
                            <Style TargetType="ui:SymbolIcon">
                                <Setter Property="Symbol" Value="ChevronDown24" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCollapsed}" Value="True">
                                        <Setter Property="Symbol" Value="ChevronUp24" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ui:SymbolIcon.Style>
                    </ui:SymbolIcon>
                </ui:Button>
            </StackPanel>
        </ctl:PanelCard.HeaderTrailing>
        <!-- 터미널은 테마와 무관하게 어두운 화면을 유지한다(셸 색상 체계 보존). 접으면 본문만 숨긴다(셸은 계속 실행). -->
        <Border Background="#0C0C0C" Padding="8,6" ClipToBounds="True">
            <Border.Style>
                <Style TargetType="Border">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsCollapsed}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <ctl:TerminalControl x:Name="TerminalView" Session="{Binding Session}"
                                 TerminalFontSize="{Binding FontSize}"
                                 ColorScheme="{Binding ColorScheme}"
                                 AutomationProperties.AutomationId="Terminal"
                                 AutomationProperties.Name="{loc:T '터미널', 'Terminal'}" />
        </Border>
    </ctl:PanelCard>
</UserControl>