<UserControl x:Class="PathDock.App.Views.TerminalPanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:PathDock.App.Localization"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:ctl="clr-namespace:PathDock.App.Controls"
             xmlns:vm="clr-namespace:PathDock.App.ViewModels">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <!-- 탭 줄 버튼: 테두리 없는 투명 버튼, 마우스를 올리면 배경만 바뀐다. 포커스를 가져가지 않는다(터미널 입력 유지). -->
        <Style x:Key="PdTabButtonStyle" TargetType="Button">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="FontSize" Value="{DynamicResource PdFontSize}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <!-- 터미널 패널: 머리글 오른쪽에 셸 상태와 접기/펼치기 버튼, 본문 위쪽에 탭 줄. DataContext: TerminalViewModel -->
    <ctl:PanelCard Header="{Binding Header}" Symbol="WindowConsole20">
        <ctl:PanelCard.HeaderTrailing>
            <StackPanel Orientation="Horizontal">
                <TextBlock FontSize="{DynamicResource PdFontSize}" Text="{Binding StatusText}" VerticalAlignment="Center"
                           AutomationProperties.AutomationId="TerminalStatus"
                           AutomationProperties.Name="{Binding StatusText}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                            <Style.Triggers>
                                <!-- 이동이 보류 중이면 강조색 + 굵게: 탐색기와 터미널 경로가 다른 이유를 알려 준다 -->
                                <DataTrigger Binding="{Binding IsPending}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <ui:SymbolIcon Symbol="QuestionCircle24" FontSize="14" Margin="10,0,2,0" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               ToolTip="{loc:T '마우스 드래그: 글자 선택 (더블클릭: 단어)&#x0A;Ctrl+C: 선택이 있으면 복사, 없으면 실행 중단&#x0A;Ctrl+Shift+C: 복사&#x0A;Ctrl+V: 붙여넣기&#x0A;우클릭: 선택이 있으면 복사, 없으면 붙여넣기&#x0A;휠: 지난 출력 보기', 'Mouse drag: select text (double-click: word)&#x0A;Ctrl+C: copy if there is a selection, otherwise interrupt&#x0A;Ctrl+Shift+C: copy&#x0A;Ctrl+V: paste&#x0A;Right-click: copy if there is a selection, otherwise paste&#x0A;Wheel: scroll back through output'}"
                               AutomationProperties.AutomationId="TerminalHelp" AutomationProperties.Name="{loc:T '터미널 사용법', 'Terminal help'}" />
                <ui:Button Margin="6,-3,0,-3" Padding="16,3" MinWidth="50" BorderThickness="0" Foreground="{DynamicResource PdRefreshForegroundBrush}"
                           Background="{DynamicResource PdTermClearBackgroundBrush}" MouseOverBackground="{DynamicResource PdTermClearHoverBrush}" PressedBackground="{DynamicResource PdTermClearHoverBrush}"
                           Command="{Binding ClearScreenCommand}" Click="OnClearClick"
                           ToolTip="{loc:T '터미널 화면 지우기', 'Clear terminal screen'}"
                           AutomationProperties.AutomationId="TerminalClearButton"
                           AutomationProperties.Name="{loc:T '터미널 화면 지우기', 'Clear terminal screen'}">
                    <ui:SymbolIcon Symbol="Eraser24" FontSize="14" />
                </ui:Button>
                <ui:Button Margin="4,-3,0,-3" Padding="16,3" MinWidth="50" BorderThickness="0" Foreground="{DynamicResource PdRefreshForegroundBrush}"
                           Background="{DynamicResource PdTermSaveBackgroundBrush}" MouseOverBackground="{DynamicResource PdTermSaveHoverBrush}" PressedBackground="{DynamicResource PdTermSaveHoverBrush}"
                           Command="{Binding SaveOutputCommand}"
                           ToolTip="{loc:T '터미널 내용을 파일로 저장', 'Save terminal contents to a file'}"
                           AutomationProperties.AutomationId="TerminalSaveButton"
                           AutomationProperties.Name="{loc:T '터미널 내용 저장', 'Save terminal contents'}">
                    <ui:SymbolIcon Symbol="Save24" FontSize="14" />
                </ui:Button>
                <ui:Button Margin="4,-3,-6,-3" Padding="16,3" MinWidth="50" BorderThickness="0" Foreground="{DynamicResource PdRefreshForegroundBrush}"
                           Background="{DynamicResource PdTermCollapseBackgroundBrush}" MouseOverBackground="{DynamicResource PdTermCollapseHoverBrush}" PressedBackground="{DynamicResource PdTermCollapseHoverBrush}"
                           Command="{Binding ToggleCollapsedCommand}"
                           ToolTip="{Binding CollapseToolTip}"
                           AutomationProperties.AutomationId="TerminalCollapseButton"
                           AutomationProperties.Name="{Binding CollapseToolTip}">
                    <ui:SymbolIcon FontSize="14">
                        <ui:SymbolIcon.Style>
                            <Style TargetType="ui:SymbolIcon">
                                <Setter Property="Symbol" Value="ChevronDown24" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCollapsed}" Value="True">
                                        <Setter Property="Symbol" Value="ChevronUp24" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ui:SymbolIcon.Style>
                    </ui:SymbolIcon>
                </ui:Button>
            </StackPanel>
        </ctl:PanelCard.HeaderTrailing>
        <!-- 탭 줄 + 터미널 화면. 접으면 본문 전체를 숨긴다(셸은 계속 실행). -->
        <Grid>
            <Grid.Style>
                <Style TargetType="Grid">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsCollapsed}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 탭 줄: 탭 버튼들(가로 스크롤) + 새 탭(+) 버튼. 버튼은 포커스를 가져가지 않아 터미널 입력이 끊기지 않는다. -->
            <Border Grid.Row="0" x:Name="TabStrip" Background="{DynamicResource ControlFillColorSecondaryBrush}"
                    BorderBrush="{DynamicResource ControlStrongStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource PdTabButtonStyle}" Padding="10,4"
                            Command="{Binding NewTabCommand}"
                            ToolTip="{loc:T '새 탭 (Ctrl+Shift+T)', 'New tab (Ctrl+Shift+T)'}"
                            AutomationProperties.AutomationId="TerminalTabAdd"
                            AutomationProperties.Name="{loc:T '새 터미널 탭', 'New terminal tab'}">
                        <ui:SymbolIcon Symbol="Add20" FontSize="14" />
                    </Button>
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Focusable="False">
                        <ItemsControl ItemsSource="{Binding Tabs}" Focusable="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:TerminalTab}">
                                    <Border x:Name="TabBorder" BorderThickness="0,0,0,2" BorderBrush="Transparent" Margin="0,0,1,0">
                                        <StackPanel Orientation="Horizontal">
                                            <Button Style="{StaticResource PdTabButtonStyle}" Padding="10,4,4,4"
                                                    MinWidth="70" MaxWidth="170"
                                                    Command="{Binding DataContext.SelectTabCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip="{Binding Cwd}"
                                                    AutomationProperties.AutomationId="{Binding AutomationId}"
                                                    AutomationProperties.Name="{Binding Title}">
                                                <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                                            </Button>
                                            <Button Style="{StaticResource PdTabButtonStyle}" Padding="4"
                                                    Visibility="{Binding DataContext.HasMultipleTabs, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}"
                                                    Command="{Binding DataContext.CloseTabCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip="{loc:T '탭 닫기 (Ctrl+Shift+W)', 'Close tab (Ctrl+Shift+W)'}"
                                                    AutomationProperties.AutomationId="{Binding CloseAutomationId}"
                                                    AutomationProperties.Name="{loc:T '탭 닫기', 'Close tab'}">
                                                <ui:SymbolIcon Symbol="Dismiss20" FontSize="12" />
                                            </Button>
                                        </StackPanel>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                            <Setter TargetName="TabBorder" Property="BorderBrush" Value="{DynamicResource SystemAccentColorPrimaryBrush}" />
                                            <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource ControlFillColorTertiaryBrush}" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- 터미널은 테마와 무관하게 어두운 화면을 유지한다(셸 색상 체계 보존). -->
            <Border Grid.Row="1" Background="#0C0C0C" Padding="8,6" ClipToBounds="True">
                <ctl:TerminalControl x:Name="TerminalView" Session="{Binding Session}"
                                     TerminalFontSize="{Binding FontSize}"
                                     ColorScheme="{Binding ColorScheme}"
                                     AutomationProperties.AutomationId="Terminal"
                                     AutomationProperties.Name="{loc:T '터미널', 'Terminal'}" />
            </Border>
        </Grid>
    </ctl:PanelCard>
</UserControl>