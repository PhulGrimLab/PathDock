<ui:FluentWindow x:Class="PathDock.App.Views.AboutWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:PathDock.App.Localization"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:ctl="clr-namespace:PathDock.App.Controls"
                 FontFamily="{StaticResource PdFontFamily}"
                 Title="{loc:T 'PathDock 정보', 'About PathDock'}" Width="560" SizeToContent="Height"
                 ResizeMode="NoResize" ShowInTaskbar="False"
                 WindowStartupLocation="CenterOwner"
                 ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="{loc:T 'PathDock 정보', 'About PathDock'}" ShowMinimize="False" ShowMaximize="False" />

        <StackPanel Grid.Row="1" Margin="28,8,28,24">
            <!-- 제품 소개 -->
            <StackPanel Orientation="Horizontal">
                <Image Source="pack://application:,,,/Assets/PathDock.png" Width="72" Height="72"
                       RenderOptions.BitmapScalingMode="HighQuality" />
                <StackPanel Margin="18,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="PathDock" FontSize="28" FontWeight="SemiBold" />
                    <TextBlock x:Name="VersionText" FontSize="13" Margin="0,2,0,0"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               AutomationProperties.AutomationId="AboutVersionTextBlock" />
                </StackPanel>
            </StackPanel>

            <TextBlock x:Name="TaglineText" Margin="0,16,0,0" TextWrapping="Wrap" />

            <!-- 상세 정보 카드 -->
            <ctl:PanelCard Margin="0,18,0,0" Header="{loc:T '제품 정보', 'About'}" Symbol="Info24" ContentPadding="14,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="86" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="{loc:T '제작', 'Author'}" Margin="0,4" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <TextBlock Grid.Row="0" Grid.Column="1" x:Name="AuthorText" Margin="0,4" FontWeight="SemiBold" />

                    <TextBlock Grid.Row="1" Text="{loc:T '문의', 'Contact'}" Margin="0,4" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Margin="0,4">
                        <Hyperlink x:Name="MailLink" Click="OnMailClick" AutomationProperties.AutomationId="AboutMailLink" />
                    </TextBlock>

                    <TextBlock Grid.Row="2" Text="{loc:T '사용 기술', 'Technologies'}" Margin="0,4" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <TextBlock Grid.Row="2" Grid.Column="1" x:Name="TechText" Margin="0,4" TextWrapping="Wrap" />

                    <TextBlock Grid.Row="3" Text="{loc:T '데이터 폴더', 'Data folder'}" Margin="0,4" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <TextBlock Grid.Row="3" Grid.Column="1" x:Name="DataDirText" Margin="0,4" TextWrapping="Wrap" />

                    <TextBlock Grid.Row="4" Text="{loc:T '로그 폴더', 'Log folder'}" Margin="0,4" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <TextBlock Grid.Row="4" Grid.Column="1" x:Name="LogDirText" Margin="0,4" TextWrapping="Wrap" />
                </Grid>
            </ctl:PanelCard>

            <TextBlock x:Name="EnvironmentText" Margin="2,12,0,0" FontSize="11" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       AutomationProperties.AutomationId="AboutEnvironmentTextBlock" />
            <TextBlock x:Name="CopyrightText" Margin="2,4,0,0" FontSize="11"
                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <TextBlock x:Name="CopiedText" VerticalAlignment="Center" Margin="0,0,12,0"
                           Foreground="{DynamicResource SystemAccentColorPrimaryBrush}" />
                <ui:Button Content="{loc:T '정보 복사', 'Copy info'}" Icon="{ui:SymbolIcon Copy24}" Margin="0,0,8,0" Click="OnCopyClick"
                           ToolTip="{loc:T '버전과 실행 환경을 클립보드에 복사합니다. 문의할 때 붙여 넣으면 도움이 됩니다.', 'Copies the version and environment info to the clipboard. Handy to paste when you contact us.'}"
                           AutomationProperties.AutomationId="AboutCopyButton" />
                <ui:Button Content="{loc:T '로그 폴더 열기', 'Open log folder'}" Icon="{ui:SymbolIcon FolderOpen24}" Margin="0,0,8,0" Click="OnOpenLogsClick"
                           AutomationProperties.AutomationId="AboutLogsButton" />
                <ui:Button Content="{loc:T '닫기', 'Close'}" Appearance="Primary" MinWidth="80" IsDefault="True" IsCancel="True"
                           Click="OnCloseClick" AutomationProperties.AutomationId="AboutCloseButton" />
            </StackPanel>
        </StackPanel>
    </Grid>
</ui:FluentWindow>
