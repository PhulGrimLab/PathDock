<ui:FluentWindow x:Class="PathDock.App.Views.SettingsWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:PathDock.App.Localization"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:ctl="clr-namespace:PathDock.App.Controls"
                 FontFamily="{StaticResource PdFontFamily}"
                 Title="{loc:T '설정', 'Settings'}" Width="460" SizeToContent="Height"
                 ResizeMode="NoResize" ShowInTaskbar="False"
                 WindowStartupLocation="CenterOwner"
                 ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica">
    <ui:FluentWindow.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </ui:FluentWindow.Resources>
    <!-- 설정 창. DataContext: MainViewModel. 글자 크기는 움직이는 즉시 화면에 반영된다. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="{loc:T '설정', 'Settings'}" ShowMinimize="False" ShowMaximize="False" />

        <StackPanel Grid.Row="1" Margin="24,8,24,22">
            <ctl:PanelCard Header="{loc:T '언어', 'Language'}" Symbol="LocalLanguage24" ContentPadding="14,10">
                <StackPanel>
                    <ComboBox SelectedIndex="{Binding LanguageIndex}"
                              AutomationProperties.AutomationId="LanguageCombo" AutomationProperties.Name="{loc:T '언어', 'Language'}">
                        <ComboBoxItem Content="한국어" />
                        <ComboBoxItem Content="English" />
                    </ComboBox>
                    <TextBlock Text="{loc:T '바꾸면 화면이 바로 바뀝니다.', 'The display changes immediately.'}" Margin="0,6,0,0"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </ctl:PanelCard>

            <ctl:PanelCard Margin="0,14,0,0" Header="{loc:T '글자 크기', 'Font size'}" Symbol="TextFont24" ContentPadding="14,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="40" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="{loc:T '화면', 'Display'}" VerticalAlignment="Center" Margin="0,6" />
                    <Slider Grid.Row="0" Grid.Column="1" VerticalAlignment="Center" Margin="0,6"
                            Minimum="10" Maximum="20" TickFrequency="1" IsSnapToTickEnabled="True"
                            Value="{Binding UiFontSize}"
                            AutomationProperties.AutomationId="UiFontSizeSlider" AutomationProperties.Name="{loc:T '화면 글자 크기', 'Display font size'}" />
                    <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding UiFontSize}" HorizontalAlignment="Right" VerticalAlignment="Center" />

                    <TextBlock Grid.Row="1" Text="{loc:T '터미널', 'Terminal'}" VerticalAlignment="Center" Margin="0,6" />
                    <Slider Grid.Row="1" Grid.Column="1" VerticalAlignment="Center" Margin="0,6"
                            Minimum="10" Maximum="28" TickFrequency="1" IsSnapToTickEnabled="True"
                            Value="{Binding TerminalFontSize}"
                            AutomationProperties.AutomationId="TerminalFontSizeSlider" AutomationProperties.Name="{loc:T '터미널 글자 크기', 'Terminal font size'}" />
                    <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding TerminalFontSize}" HorizontalAlignment="Right" VerticalAlignment="Center" />

                    <ui:Button Grid.Row="2" Grid.ColumnSpan="3" Content="{loc:T '기본 크기로', 'Reset sizes'}" Icon="{ui:SymbolIcon ArrowReset24}"
                               HorizontalAlignment="Right" Margin="0,8,0,0"
                               Command="{Binding ResetFontsCommand}"
                               AutomationProperties.AutomationId="ResetFontsButton" />
                </Grid>
            </ctl:PanelCard>

            <ctl:PanelCard Margin="0,14,0,0" Header="{loc:T '시작', 'Startup'}" Symbol="Folder24" ContentPadding="14,10">
                <CheckBox Content="{loc:T '마지막으로 열었던 폴더에서 시작 (끄면 사용자 폴더에서 시작)', 'Start in the last opened folder (if off, start in the user folder)'}"
                          IsChecked="{Binding StartAtLastPath}"
                          AutomationProperties.AutomationId="StartAtLastPathCheck" />
            </ctl:PanelCard>

            <ctl:PanelCard Margin="0,14,0,0" Header="{loc:T '터미널 색상', 'Terminal colors'}" Symbol="Color24" ContentPadding="14,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="{loc:T '테마', 'Theme'}" VerticalAlignment="Center" Margin="0,4" />
                    <ComboBox Grid.Column="1" Grid.ColumnSpan="2" Margin="0,4" ItemsSource="{Binding TerminalThemeOptions}" DisplayMemberPath="Name" SelectedIndex="{Binding TerminalThemeIndex}"
                              AutomationProperties.AutomationId="TerminalThemeCombo" AutomationProperties.Name="{loc:T '터미널 테마', 'Terminal theme'}" />
                    <TextBlock Grid.Row="1" Text="{loc:T '글자색', 'Text color'}" VerticalAlignment="Center" Margin="0,4" />
                    <ui:TextBox Grid.Row="1" Grid.Column="1" Margin="0,4" MaxLength="7" PlaceholderText="{loc:T '#RRGGBB (비우면 테마 기본값)', '#RRGGBB (empty = theme default)'}"
                                Text="{Binding TerminalForeground, UpdateSourceTrigger=PropertyChanged}"
                                AutomationProperties.AutomationId="TerminalForegroundBox" AutomationProperties.Name="{loc:T '터미널 글자색', 'Terminal text color'}" />
                    <!-- 지금 적용되는 색 미리보기(비우면 테마 기본값) -->
                    <Border Grid.Row="1" Grid.Column="2" Width="28" Height="28" Margin="8,4,0,4" CornerRadius="4" BorderThickness="1"
                            BorderBrush="{DynamicResource ControlStrongStrokeColorDefaultBrush}"
                            Background="{Binding TerminalForegroundPreview}" ToolTip="{loc:T '현재 적용되는 글자색', 'Text color currently applied'}"
                            AutomationProperties.AutomationId="TerminalForegroundPreview" />
                    <TextBlock Grid.Row="2" Text="{loc:T '배경색', 'Background color'}" VerticalAlignment="Center" Margin="0,4" />
                    <ui:TextBox Grid.Row="2" Grid.Column="1" Margin="0,4" MaxLength="7" PlaceholderText="{loc:T '#RRGGBB (비우면 테마 기본값)', '#RRGGBB (empty = theme default)'}"
                                Text="{Binding TerminalBackground, UpdateSourceTrigger=PropertyChanged}"
                                AutomationProperties.AutomationId="TerminalBackgroundBox" AutomationProperties.Name="{loc:T '터미널 배경색', 'Terminal background color'}" />
                    <Border Grid.Row="2" Grid.Column="2" Width="28" Height="28" Margin="8,4,0,4" CornerRadius="4" BorderThickness="1"
                            BorderBrush="{DynamicResource ControlStrongStrokeColorDefaultBrush}"
                            Background="{Binding TerminalBackgroundPreview}" ToolTip="{loc:T '현재 적용되는 배경색', 'Background color currently applied'}"
                            AutomationProperties.AutomationId="TerminalBackgroundPreview" />
                    <TextBlock Grid.Row="3" Grid.ColumnSpan="3" Margin="0,4,0,0" TextWrapping="Wrap" Foreground="#E5484D"
                               Text="{Binding ColorErrorText}"
                               Visibility="{Binding HasColorError, Converter={StaticResource BoolToVis}}"
                               AutomationProperties.AutomationId="TerminalColorError" />
                    <ui:Button Grid.Row="4" Grid.ColumnSpan="3" Content="{loc:T '기본 색으로', 'Reset colors'}" Icon="{ui:SymbolIcon ArrowReset24}"
                               HorizontalAlignment="Right" Margin="0,8,0,0"
                               Command="{Binding ResetTerminalColorsCommand}"
                               AutomationProperties.AutomationId="ResetTerminalColorsButton" />
                </Grid>
            </ctl:PanelCard>

            <ctl:PanelCard Margin="0,14,0,0" Header="{loc:T '터미널 셸', 'Terminal shell'}" Symbol="WindowConsole20" ContentPadding="14,10">
                <StackPanel>
                    <ComboBox SelectedIndex="{Binding TerminalShellIndex}"
                              AutomationProperties.AutomationId="TerminalShellCombo" AutomationProperties.Name="{loc:T '터미널 셸', 'Terminal shell'}">
                        <ComboBoxItem Content="PowerShell" />
                        <ComboBoxItem Content="{loc:T '명령 프롬프트 (cmd)', 'Command Prompt (cmd)'}" />
                    </ComboBox>
                    <TextBlock Text="{loc:T '바꾸면 터미널이 새 셸로 바로 다시 시작됩니다(같은 폴더에서).', 'Changing this restarts the terminal with the new shell right away (in the same folder).'}" Margin="0,6,0,0" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </ctl:PanelCard>

            <ctl:PanelCard Margin="0,14,0,0" Header="{loc:T '초기화', 'Reset'}" Symbol="Delete24" ContentPadding="14,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{loc:T '등록한 즐겨찾기 10칸을 모두 비웁니다.', 'Clears all 10 favorite slots.'}" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <ui:Button Grid.Column="1" Content="{loc:T '즐겨찾기 초기화', 'Reset favorites'}" Icon="{ui:SymbolIcon Delete24}" Appearance="Danger"
                               Command="{Binding ResetFavoritesCommand}"
                               AutomationProperties.AutomationId="ResetFavoritesButton" />
                </Grid>
            </ctl:PanelCard>

            <ui:Button Content="{loc:T '닫기', 'Close'}" Appearance="Primary" MinWidth="80" HorizontalAlignment="Right" Margin="0,20,0,0"
                       IsDefault="True" IsCancel="True" Click="OnCloseClick"
                       AutomationProperties.AutomationId="SettingsCloseButton" />
        </StackPanel>
    </Grid>
</ui:FluentWindow>