<ui:FluentWindow x:Class="PathDock.App.Views.SettingsWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:ctl="clr-namespace:PathDock.App.Controls"
                 FontFamily="{StaticResource PdFontFamily}"
                 Title="설정" Width="460" SizeToContent="Height"
                 ResizeMode="NoResize" ShowInTaskbar="False"
                 WindowStartupLocation="CenterOwner"
                 ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica">
    <!-- 설정 창. DataContext: MainViewModel. 글자 크기는 움직이는 즉시 화면에 반영된다. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="설정" ShowMinimize="False" ShowMaximize="False" />

        <StackPanel Grid.Row="1" Margin="24,8,24,22">
            <ctl:PanelCard Header="글자 크기" Symbol="TextFont24" ContentPadding="14,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="86" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="40" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="화면" VerticalAlignment="Center" Margin="0,6" />
                    <Slider Grid.Row="0" Grid.Column="1" VerticalAlignment="Center" Margin="0,6"
                            Minimum="10" Maximum="20" TickFrequency="1" IsSnapToTickEnabled="True"
                            Value="{Binding UiFontSize}"
                            AutomationProperties.AutomationId="UiFontSizeSlider" AutomationProperties.Name="화면 글자 크기" />
                    <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding UiFontSize}" HorizontalAlignment="Right" VerticalAlignment="Center" />

                    <TextBlock Grid.Row="1" Text="터미널" VerticalAlignment="Center" Margin="0,6" />
                    <Slider Grid.Row="1" Grid.Column="1" VerticalAlignment="Center" Margin="0,6"
                            Minimum="10" Maximum="28" TickFrequency="1" IsSnapToTickEnabled="True"
                            Value="{Binding TerminalFontSize}"
                            AutomationProperties.AutomationId="TerminalFontSizeSlider" AutomationProperties.Name="터미널 글자 크기" />
                    <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding TerminalFontSize}" HorizontalAlignment="Right" VerticalAlignment="Center" />

                    <ui:Button Grid.Row="2" Grid.ColumnSpan="3" Content="기본 크기로" Icon="{ui:SymbolIcon ArrowReset24}"
                               HorizontalAlignment="Right" Margin="0,8,0,0"
                               Command="{Binding ResetFontsCommand}"
                               AutomationProperties.AutomationId="ResetFontsButton" />
                </Grid>
            </ctl:PanelCard>

            <ctl:PanelCard Margin="0,14,0,0" Header="시작" Symbol="Folder24" ContentPadding="14,10">
                <CheckBox Content="마지막으로 열었던 폴더에서 시작 (끄면 사용자 폴더에서 시작)"
                          IsChecked="{Binding StartAtLastPath}"
                          AutomationProperties.AutomationId="StartAtLastPathCheck" />
            </ctl:PanelCard>

            <ctl:PanelCard Margin="0,14,0,0" Header="초기화" Symbol="Delete24" ContentPadding="14,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="등록한 즐겨찾기 10칸을 모두 비웁니다." VerticalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <ui:Button Grid.Column="1" Content="즐겨찾기 초기화" Icon="{ui:SymbolIcon Delete24}"
                               Command="{Binding ResetFavoritesCommand}"
                               AutomationProperties.AutomationId="ResetFavoritesButton" />
                </Grid>
            </ctl:PanelCard>

            <ui:Button Content="닫기" Appearance="Primary" MinWidth="80" HorizontalAlignment="Right" Margin="0,20,0,0"
                       IsDefault="True" IsCancel="True" Click="OnCloseClick"
                       AutomationProperties.AutomationId="SettingsCloseButton" />
        </StackPanel>
    </Grid>
</ui:FluentWindow>