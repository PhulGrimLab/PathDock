<UserControl x:Class="PathDock.App.Views.FileListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:PathDock.App.Localization"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:ctl="clr-namespace:PathDock.App.Controls"
             xmlns:vm="clr-namespace:PathDock.App.ViewModels">
    <UserControl.Resources>
        <!-- 열 머리글: 기본(굵은 14pt)보다 한 단계 작고 가벼운 글자로 정리 -->
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <Style x:Key="PdHeaderStyle" TargetType="GridViewColumnHeader" BasedOn="{StaticResource UiGridViewColumnHeaderStyle}">
            <Setter Property="FontSize" Value="{DynamicResource PdFontSize}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </UserControl.Resources>
    <!-- 현재 폴더 목록: 종류별 아이콘, 정렬 가능한 머리글, 폴더 크기/하위 항목, 요약 줄. DataContext: ExplorerViewModel -->
    <ctl:PanelCard Header="{Binding CurrentFolderName}" Symbol="Folder24">
        <ctl:PanelCard.HeaderTrailing>
        <StackPanel Orientation="Horizontal">
            <!-- 새로 고침: 이름 검색 앞의 녹색 버튼(F5와 같음, 폴더 크기도 다시 계산). 색은 PdRefresh*Brush(ThemeService) -->
            <ui:Button Padding="14,2" Margin="0,-4,0,-4" MinWidth="44" MinHeight="26" Height="26" VerticalAlignment="Center" BorderThickness="0"
                       Background="{DynamicResource PdRefreshBackgroundBrush}" MouseOverBackground="{DynamicResource PdRefreshHoverBrush}"
                       PressedBackground="{DynamicResource PdRefreshHoverBrush}" Foreground="{DynamicResource PdRefreshForegroundBrush}"
                       Icon="{ui:SymbolIcon ArrowClockwise24}" Command="{Binding RefreshCommand}"
                       ToolTip="{loc:T '새로 고침 (F5) - 폴더 크기도 다시 계산', 'Refresh (F5) - recalculates folder sizes too'}"
                       AutomationProperties.AutomationId="{Binding AutomationSuffix, StringFormat=ListRefreshButton{0}}" AutomationProperties.Name="{loc:T '새로 고침', 'Refresh'}" />
            <!-- 이름 검색(Ctrl+F로 이동): 입력한 글자가 이름에 들어간 파일/폴더만 목록에 보인다. Esc나 폴더 이동 시 해제 -->
            <ui:TextBox x:Name="FilterBox" Width="170" MinHeight="26" Height="26" Margin="4,-4,-6,-4" Padding="6,2"
                        FontSize="{DynamicResource PdFontSize}"
                        PlaceholderText="{loc:T '이름 검색 (Ctrl+F)', 'Search names (Ctrl+F)'}"
                        Icon="{ui:SymbolIcon Search24}"
                        Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}"
                        KeyDown="FilterBox_KeyDown"
                        AutomationProperties.AutomationId="{Binding AutomationSuffix, StringFormat=FilterBox{0}}" AutomationProperties.Name="{loc:T '이름 검색', 'Search names'}" />
        </StackPanel>
        </ctl:PanelCard.HeaderTrailing>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <ui:ListView x:Name="FileList" Grid.Row="0" Margin="4,4,4,0" BorderThickness="0" Background="Transparent" FontSize="{DynamicResource PdFontSize}"
                         ItemsSource="{Binding Items}"
                         SelectedItem="{Binding SelectedItem}"
                         SelectionMode="Extended"
                         AllowDrop="True"
                         PreviewMouseLeftButtonDown="OnListMouseDown"
                         PreviewMouseLeftButtonUp="OnListMouseUp"
                         PreviewMouseMove="OnListMouseMove"
                         DragOver="OnListDragOver"
                         DragLeave="OnListDragLeave"
                         Drop="OnListDrop"
                         SelectionChanged="FileList_SelectionChanged"
                         AutomationProperties.AutomationId="{Binding AutomationSuffix, StringFormat=FileList{0}}"
                         AutomationProperties.Name="{loc:T '파일 목록', 'File list'}"
                         MouseDoubleClick="FileList_MouseDoubleClick"
                         KeyDown="FileList_KeyDown">
                <ui:ListView.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="{loc:T '복사 (Ctrl+C)', 'Copy (Ctrl+C)'}" Command="{Binding CopySelectedCommand}" />
                        <MenuItem Header="{loc:T '잘라내기 (Ctrl+X)', 'Cut (Ctrl+X)'}" Command="{Binding CutSelectedCommand}" />
                        <MenuItem Header="{loc:T '붙여넣기 (Ctrl+V)', 'Paste (Ctrl+V)'}" Command="{Binding PasteCommand}" />
                        <Separator />
                        <MenuItem Header="{loc:T '이름 변경 (F2)', 'Rename (F2)'}" Command="{Binding RenameSelectedCommand}" />
                        <MenuItem Header="{loc:T '삭제 - 휴지통 (Delete)', 'Delete - Recycle Bin (Delete)'}" Command="{Binding DeleteSelectedCommand}" />
                        <Separator />
                        <MenuItem Header="{loc:T '새 폴더 (Ctrl+Shift+N)', 'New folder (Ctrl+Shift+N)'}" Command="{Binding NewFolderCommand}" />
                        <MenuItem Header="{loc:T '숨김 파일 표시 (Ctrl+H)', 'Show hidden files (Ctrl+H)'}" IsCheckable="True" IsChecked="{Binding ShowHidden, Mode=TwoWay}" />
                        <Separator />
                        <MenuItem Header="{loc:T '열기 (Enter)', 'Open (Enter)'}" Command="{Binding OpenItemCommand}" CommandParameter="{Binding SelectedItem}" />
                        <MenuItem Header="{loc:T '연결 프로그램 선택...', 'Open with...'}" Command="{Binding OpenWithCommand}" />
                        <MenuItem Header="{loc:T '탐색기에서 보기', 'Show in File Explorer'}" Command="{Binding ShowInExplorerCommand}" />
                        <MenuItem Header="{loc:T '경로 복사 (Ctrl+Shift+C)', 'Copy path (Ctrl+Shift+C)'}" Command="{Binding CopyPathCommand}" />
                        <MenuItem Header="{loc:T '터미널에 경로 입력 (Ctrl+Shift+V)', 'Type path into terminal (Ctrl+Shift+V)'}" Command="{Binding SendPathsToTerminalCommand}" />
                        <MenuItem Header="{loc:T '속성 (Alt+Enter)', 'Properties (Alt+Enter)'}" Command="{Binding ShowPropertiesCommand}" />
                    </ContextMenu>
                </ui:ListView.ContextMenu>
                <ui:ListView.View>
                    <ui:GridView ColumnHeaderContainerStyle="{StaticResource PdHeaderStyle}">
                        <ui:GridViewColumn x:Name="NameColumn" Header="{loc:T '이름', 'Name'}" Width="280">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate DataType="{x:Type vm:FileItemViewModel}">
                                    <StackPanel Orientation="Horizontal" ToolTipService.InitialShowDelay="400" Opacity="{Binding RowOpacity}"
                                                ToolTipOpening="OnNameToolTipOpening">
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Style.Triggers>
                                                    <!-- 끌어 놓을 폴더 행 강조 -->
                                                    <DataTrigger Binding="{Binding IsDropTarget}" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource SystemAccentColorPrimaryBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <!-- 이미지(썸네일)·텍스트(앞 20줄) 파일 위에서만 뜨는 툴팁(그 밖의 파일은 코드 숨김에서 열리지 않게 막는다) -->
                                        <StackPanel.ToolTip>
                                            <ToolTip FontFamily="{StaticResource PdFontFamily}">
                                                <StackPanel>
                                                    <Image Source="{Binding Preview.Image}" MaxWidth="240" Stretch="Uniform" StretchDirection="DownOnly"
                                                           Visibility="{Binding ShowsImagePreview, Converter={StaticResource BoolToVis}}"
                                                           RenderOptions.BitmapScalingMode="HighQuality"
                                                           AutomationProperties.AutomationId="ImagePreview" />
                                                    <TextBlock Text="{Binding TextPreview.Text}" Width="480" MaxHeight="360" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                                               FontFamily="Cascadia Mono, Consolas, D2Coding, Malgun Gothic"
                                                               Visibility="{Binding IsTextFile, Converter={StaticResource BoolToVis}}"
                                                               AutomationProperties.AutomationId="TextPreview" />
                                                    <!-- 파일 정보 줄: 위 내용과 구분되도록 별도 배경 띠 + 위쪽 구분선 + 또렷한 글자색 -->
                                                    <Border Margin="0,6,0,0" Padding="8,4"
                                                            Background="{DynamicResource PdAddressBarBackgroundBrush}"
                                                            BorderBrush="{DynamicResource PdAddressBarBorderBrush}" BorderThickness="0,1,0,0"
                                                            AutomationProperties.AutomationId="PreviewInfoBand">
                                                        <TextBlock HorizontalAlignment="Center" FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                                   Text="{Binding PreviewInfo}" />
                                                    </Border>
                                                </StackPanel>
                                            </ToolTip>
                                        </StackPanel.ToolTip>                                        <ui:SymbolIcon Margin="0,0,8,0" FontSize="16"
                                                       Symbol="{Binding IconSymbol}"
                                                       Foreground="{Binding IconBrush}"
                                                       Filled="{Binding IsDirectory}" />
                                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center"
                                                   AutomationProperties.Name="{Binding Name}" />
                                    </StackPanel>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </ui:GridViewColumn>
                        <ui:GridViewColumn x:Name="ModifiedColumn" Header="{loc:T '수정한 날짜', 'Date modified'}" Width="140"
                                           DisplayMemberBinding="{Binding ModifiedText}" />
                        <ui:GridViewColumn x:Name="SizeColumn" Header="{loc:T '크기', 'Size'}" Width="130"
                                           DisplayMemberBinding="{Binding SizeText}" />
                        <ui:GridViewColumn x:Name="CountColumn" Header="{loc:T '하위 항목', 'Contents'}" Width="150"
                                           DisplayMemberBinding="{Binding CountText}" />
                    </ui:GridView>
                </ui:ListView.View>
            </ui:ListView>

            <!-- 요약 줄 -->
            <Border Grid.Row="1" Padding="12,6" BorderThickness="0,1,0,0"
                    BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}">
                <StackPanel>
                    <TextBlock Text="{Binding SummaryDisplay}" TextWrapping="Wrap" FontSize="{DynamicResource PdFontSize}"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               AutomationProperties.AutomationId="FolderSummary"
                               AutomationProperties.Name="{Binding SummaryDisplay}" />
                    <!-- 붙여넣기(복사/이동) 진행: 0.3초 넘게 걸릴 때만 나타난다 -->
                    <Grid Margin="0,6,0,0" Visibility="{Binding IsOperationVisible, Converter={StaticResource BoolToVis}}"
                          AutomationProperties.AutomationId="OperationPanel">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding OperationText}" TextTrimming="CharacterEllipsis" FontSize="{DynamicResource PdFontSize}"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                       AutomationProperties.AutomationId="OperationText" />
                            <ProgressBar Margin="0,4,0,0" Height="6" Minimum="0" Maximum="100" Value="{Binding OperationPercent, Mode=OneWay}"
                                         AutomationProperties.AutomationId="OperationProgress" />
                        </StackPanel>
                        <ui:Button Grid.Column="1" Margin="10,0,0,0" Padding="10,3" VerticalAlignment="Center"
                                   Content="{loc:T '취소', 'Cancel'}" Command="{Binding CancelOperationCommand}"
                                   AutomationProperties.AutomationId="OperationCancelButton" />
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </ctl:PanelCard>
</UserControl>
