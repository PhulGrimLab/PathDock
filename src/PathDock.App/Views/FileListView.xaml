<UserControl x:Class="PathDock.App.Views.FileListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:ctl="clr-namespace:PathDock.App.Controls"
             xmlns:vm="clr-namespace:PathDock.App.ViewModels">
    <UserControl.Resources>
        <!-- 열 머리글: 기본(굵은 14pt)보다 한 단계 작고 가벼운 글자로 정리 -->
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <Style x:Key="PdHeaderStyle" TargetType="GridViewColumnHeader" BasedOn="{StaticResource UiGridViewColumnHeaderStyle}">
            <Setter Property="FontSize" Value="{DynamicResource PdFontSize}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </UserControl.Resources>
    <!-- 현재 폴더 목록: 종류별 아이콘, 정렬 가능한 머리글, 폴더 크기/하위 항목, 요약 줄. DataContext: ExplorerViewModel -->
    <ctl:PanelCard Header="{Binding CurrentFolderName}" Symbol="Folder24">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 이름 필터(Ctrl+F). Esc로 닫는다 -->
            <Grid Grid.Row="0" Margin="8,6,8,2" Visibility="{Binding IsFilterVisible, Converter={StaticResource BoolToVis}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ui:TextBox x:Name="FilterBox" PlaceholderText="이름 필터 (Esc: 닫기)"
                            Icon="{ui:SymbolIcon Search24}"
                            Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}"
                            KeyDown="FilterBox_KeyDown"
                            AutomationProperties.AutomationId="FilterBox" AutomationProperties.Name="이름 필터" />
                <ui:Button Grid.Column="1" Appearance="Transparent" Margin="4,0,0,0" Padding="8,5"
                           Command="{Binding CloseFilterCommand}" ToolTip="필터 닫기"
                           AutomationProperties.Name="필터 닫기">
                    <ui:SymbolIcon Symbol="Dismiss24" FontSize="14" />
                </ui:Button>
            </Grid>

            <ui:ListView x:Name="FileList" Grid.Row="1" Margin="4,4,4,0" BorderThickness="0" Background="Transparent" FontSize="{DynamicResource PdFontSize}"
                         ItemsSource="{Binding Items}"
                         SelectedItem="{Binding SelectedItem}"
                         SelectionMode="Extended"
                         SelectionChanged="FileList_SelectionChanged"
                         AutomationProperties.AutomationId="FileList"
                         AutomationProperties.Name="파일 목록"
                         MouseDoubleClick="FileList_MouseDoubleClick"
                         KeyDown="FileList_KeyDown">
                <ui:ListView.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="복사 (Ctrl+C)" Command="{Binding CopySelectedCommand}" />
                        <MenuItem Header="잘라내기 (Ctrl+X)" Command="{Binding CutSelectedCommand}" />
                        <MenuItem Header="붙여넣기 (Ctrl+V)" Command="{Binding PasteCommand}" />
                        <Separator />
                        <MenuItem Header="이름 변경 (F2)" Command="{Binding RenameSelectedCommand}" />
                        <MenuItem Header="삭제 - 휴지통 (Delete)" Command="{Binding DeleteSelectedCommand}" />
                        <Separator />
                        <MenuItem Header="새 폴더 (Ctrl+Shift+N)" Command="{Binding NewFolderCommand}" />
                    </ContextMenu>
                </ui:ListView.ContextMenu>
                <ui:ListView.View>
                    <ui:GridView ColumnHeaderContainerStyle="{StaticResource PdHeaderStyle}">
                        <ui:GridViewColumn x:Name="NameColumn" Header="이름" Width="280">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate DataType="{x:Type vm:FileItemViewModel}">
                                    <StackPanel Orientation="Horizontal" ToolTipService.InitialShowDelay="400"
                                                ToolTipOpening="OnNameToolTipOpening">
                                        <!-- 이미지 파일 위에서만 뜨는 썸네일 툴팁(그 밖의 파일은 코드 숨김에서 열리지 않게 막는다) -->
                                        <StackPanel.ToolTip>
                                            <ToolTip FontFamily="{StaticResource PdFontFamily}">
                                                <StackPanel>
                                                    <Image Source="{Binding Preview.Image}" MaxWidth="240" Stretch="Uniform" StretchDirection="DownOnly"
                                                           RenderOptions.BitmapScalingMode="HighQuality"
                                                           AutomationProperties.AutomationId="ImagePreview" />
                                                    <TextBlock Margin="0,4,0,0" HorizontalAlignment="Center"
                                                               Text="{Binding Preview.InfoText, TargetNullValue=불러오는 중…, FallbackValue=불러오는 중…}" />
                                                </StackPanel>
                                            </ToolTip>
                                        </StackPanel.ToolTip>
                                        <ui:SymbolIcon Margin="0,0,8,0" FontSize="16"
                                                       Symbol="{Binding IconSymbol}"
                                                       Foreground="{Binding IconBrush}"
                                                       Filled="{Binding IsDirectory}" />
                                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center"
                                                   AutomationProperties.Name="{Binding Name}" />
                                    </StackPanel>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </ui:GridViewColumn>
                        <ui:GridViewColumn x:Name="ModifiedColumn" Header="수정한 날짜" Width="140"
                                           DisplayMemberBinding="{Binding ModifiedText}" />
                        <ui:GridViewColumn x:Name="SizeColumn" Header="크기" Width="130"
                                           DisplayMemberBinding="{Binding SizeText}" />
                        <ui:GridViewColumn x:Name="CountColumn" Header="하위 항목" Width="150"
                                           DisplayMemberBinding="{Binding CountText}" />
                    </ui:GridView>
                </ui:ListView.View>
            </ui:ListView>

            <!-- 요약 줄 -->
            <Border Grid.Row="2" Padding="12,6" BorderThickness="0,1,0,0"
                    BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}">
                <TextBlock Text="{Binding SummaryText}" TextWrapping="Wrap" FontSize="{DynamicResource PdFontSize}"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           AutomationProperties.AutomationId="FolderSummary"
                           AutomationProperties.Name="{Binding SummaryText}" />
            </Border>
        </Grid>
    </ctl:PanelCard>
</UserControl>
