<ui:FluentWindow x:Class="PathDock.App.Views.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:ctl="clr-namespace:PathDock.App.Controls"
                 xmlns:v="clr-namespace:PathDock.App.Views"
                 xmlns:vm="clr-namespace:PathDock.App.ViewModels"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 mc:Ignorable="d"
                 d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
                 Title="PathDock"
                 FontFamily="{StaticResource PdFontFamily}"
                 Icon="pack://application:,,,/Assets/PathDock.ico"
                 MinWidth="760" MinHeight="480"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="DoNotRound">
    <!--
        화면은 색이 다른 세 개의 띠(즐겨찾기 / 탐색기 / 터미널)와 상태 표시줄로 구분한다.
        탐색기 띠는 한 개의 격자를 공유해, 이동 버튼은 드라이브 열 폭에, 주소 표시줄은 폴더 열 시작점에 정렬된다.
    -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />   <!-- 제목 표시줄 -->
            <RowDefinition Height="Auto" />   <!-- 즐겨찾기 띠 -->
            <RowDefinition Height="Auto" />   <!-- 알림 -->
            <RowDefinition x:Name="ExplorerRow" Height="*" MinHeight="140" />   <!-- 탐색기 띠 -->
            <RowDefinition Height="Auto" />   <!-- 분할 -->
            <RowDefinition x:Name="TerminalRow" Height="*" MinHeight="120" />   <!-- 터미널 띠 -->
            <RowDefinition Height="Auto" />   <!-- 상태 표시줄 -->
        </Grid.RowDefinitions>

        <!-- 제목 표시줄: 왼쪽 로고(누르면 정보 창) + 이름, 오른쪽 테마 전환 -->
        <ui:TitleBar Grid.Row="0" Title="PathDock">
            <ui:TitleBar.Header>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- 로고 왼쪽 끝을 아래 띠의 콘텐츠 시작 열(12px)에 맞춘다. TitleBar Header가 앞쪽에 32px 여백을 두므로 12-32=-20 -->
                    <ui:Button x:Name="AboutButton" Appearance="Transparent" Padding="0,3,8,3" Margin="-20,0,0,0"
                               Command="{Binding ShowAboutCommand}"
                               ToolTip="PathDock 정보"
                               AutomationProperties.AutomationId="AboutButton"
                               AutomationProperties.Name="PathDock 정보">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="pack://application:,,,/Assets/PathDock.png" Width="16" Height="16"
                                   RenderOptions.BitmapScalingMode="HighQuality" />
                            <TextBlock Text="PathDock" FontWeight="SemiBold" Margin="7,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </ui:Button>
                </StackPanel>
            </ui:TitleBar.Header>
            <ui:TitleBar.TrailingContent>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- 현재 날짜/시간(초 단위). 더블 클릭하면 Windows 알림 센터의 달력을 연다 -->
                    <TextBlock x:Name="ClockText" Background="Transparent" VerticalAlignment="Center"
                               Margin="0,0,8,0" Padding="6,4"
                               FontSize="14"
                               ToolTip="더블 클릭: 달력 열기"
                               PreviewMouseLeftButtonDown="OnClockMouseDown"
                               AutomationProperties.AutomationId="ClockText"
                               AutomationProperties.Name="현재 날짜와 시간" />
                    <ui:Button Appearance="Transparent" Margin="0,0,4,0" Padding="10,4"
                               Command="{Binding ShowSettingsCommand}"
                               ToolTip="설정"
                               AutomationProperties.AutomationId="SettingsButton"
                               AutomationProperties.Name="설정">
                        <ui:SymbolIcon Symbol="Settings24" FontSize="14" />
                    </ui:Button>
                    <ui:Button Appearance="Transparent" Margin="0,0,4,0" Padding="10,4"
                               Command="{Binding ToggleThemeCommand}"
                               ToolTip="{Binding ThemeToolTip}"
                               AutomationProperties.AutomationId="ThemeButton"
                               AutomationProperties.Name="테마 전환">
                        <ui:SymbolIcon FontSize="14">
                            <ui:SymbolIcon.Style>
                                <Style TargetType="ui:SymbolIcon">
                                    <Setter Property="Symbol" Value="WeatherMoon24" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsDarkTheme}" Value="True">
                                            <Setter Property="Symbol" Value="WeatherSunny24" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ui:SymbolIcon.Style>
                        </ui:SymbolIcon>
                    </ui:Button>
                </StackPanel>
            </ui:TitleBar.TrailingContent>
        </ui:TitleBar>

        <!-- 즐겨찾기 띠: 기본 배경 위에 강조색을 옅게 깔아 탐색기 띠와 확실히 구분(다크/라이트 공통). 왼쪽 칩, 오른쪽 동기화 모드 -->
        <Border Grid.Row="1"
                Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                BorderBrush="{DynamicResource ControlStrongStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,1">
            <Grid>
                <Border Background="{DynamicResource SystemAccentColorPrimaryBrush}" Opacity="0.16" IsHitTestVisible="False" />
                <Grid Margin="12,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <v:FavoritesBarView Grid.Column="0" VerticalAlignment="Center" />
                    <v:SyncModeSelectorView Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center" />
                </Grid>
            </Grid>
        </Border>

        <ui:InfoBar Grid.Row="2" Margin="12,6,12,0"
                    Title="알림" Severity="Warning" IsClosable="True"
                    Message="{Binding InfoMessage}"
                    IsOpen="{Binding HasInfo, Mode=OneWay}"
                    AutomationProperties.AutomationId="InfoBar" />

        <!-- 탐색기 띠 -->
        <Border Grid.Row="3" Padding="12,10,12,10"
                Background="{DynamicResource SolidBackgroundFillColorBaseBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />   <!-- 이동 버튼 + 주소 표시줄 -->
                    <RowDefinition Height="*" />      <!-- 드라이브 | 조부모 | 부모 | 현재 폴더 -->
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220" MinWidth="130" />
                    <ColumnDefinition Width="6" />
                    <ColumnDefinition Width="170" MinWidth="90" />
                    <ColumnDefinition Width="6" />
                    <ColumnDefinition Width="170" MinWidth="90" />
                    <ColumnDefinition Width="6" />
                    <ColumnDefinition Width="*" MinWidth="240" />
                </Grid.ColumnDefinitions>

                <!-- 1행: 버튼은 드라이브 열 폭을 채우고, 주소 표시줄은 조부모 열 시작점부터 끝까지 -->
                <v:NavButtonsView Grid.Row="0" Grid.Column="0" Margin="0,0,0,8" DataContext="{Binding Explorer}" />
                <ctl:AddressBar Grid.Row="0" Grid.Column="2" Grid.ColumnSpan="5" Margin="0,0,0,8"
                                Text="{Binding Explorer.PathText, Mode=TwoWay}"
                                Command="{Binding Explorer.NavigatePathCommand}"
                                TextBoxAutomationId="PathBar" TextBoxAutomationName="현재 경로" />

                <!-- 2행: 네 개의 영역 -->
                <v:DrivePanelView Grid.Row="1" Grid.Column="0" />
                <GridSplitter Grid.Row="1" Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="Transparent" />
                <v:AncestorColumnView Grid.Row="1" Grid.Column="2" DataContext="{Binding Explorer.GrandParent}" />
                <GridSplitter Grid.Row="1" Grid.Column="3" Width="6" HorizontalAlignment="Stretch" Background="Transparent" />
                <v:AncestorColumnView Grid.Row="1" Grid.Column="4" DataContext="{Binding Explorer.Parent}" />
                <GridSplitter Grid.Row="1" Grid.Column="5" Width="6" HorizontalAlignment="Stretch" Background="Transparent" />
                <v:FileListView Grid.Row="1" Grid.Column="6" DataContext="{Binding Explorer}" />
            </Grid>
        </Border>

        <!-- 탐색기/터미널 높이 조절 막대(눈에 보이는 구분선) -->
        <GridSplitter x:Name="TerminalSplitter" Grid.Row="4" Height="5" HorizontalAlignment="Stretch"
                      Background="{DynamicResource SolidBackgroundFillColorQuarternaryBrush}"
                      ResizeDirection="Rows" ResizeBehavior="PreviousAndNext" />

        <!-- 터미널 띠 -->
        <Border Grid.Row="5" Padding="12,8,12,10"
                Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}">
            <v:TerminalPanelView x:Name="TerminalPanel" DataContext="{Binding Terminal}" />
        </Border>

        <!-- 상태 표시줄 -->
        <Border Grid.Row="6"
                Background="{DynamicResource SolidBackgroundFillColorTertiaryBrush}"
                BorderBrush="{DynamicResource ControlStrongStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0">
            <v:StatusBarView />
        </Border>
    </Grid>
</ui:FluentWindow>
