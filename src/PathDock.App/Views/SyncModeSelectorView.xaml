<UserControl x:Class="PathDock.App.Views.SyncModeSelectorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:PathDock.App.Localization"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <!-- 경로 동기화 모드 선택. DataContext: MainViewModel -->
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <ui:SymbolIcon Symbol="ArrowSync24" FontSize="14" Margin="0,0,6,0"
                       Foreground="{DynamicResource SystemAccentColorPrimaryBrush}" />
        <TextBlock VerticalAlignment="Center" Margin="0,0,8,0" Text="{loc:T '경로 동기화', 'Path sync'}" FontSize="{DynamicResource PdFontSize}"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        <ComboBox MinWidth="150" MinHeight="28"
                  ItemsSource="{Binding SyncModes}"
                  SelectedItem="{Binding SelectedSyncMode}"
                  AutomationProperties.AutomationId="SyncModeCombo"
                  AutomationProperties.Name="{loc:T '동기화 모드', 'Sync mode'}">
            <!-- 선택 표시와 목록 항목 모두 명시적 TextBlock으로 그려 글자 크기를 다른 UI와 맞춘다. -->
            <ComboBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding Label}" FontSize="{DynamicResource PdFontSize}" VerticalAlignment="Center" />
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>
    </StackPanel>
</UserControl>
