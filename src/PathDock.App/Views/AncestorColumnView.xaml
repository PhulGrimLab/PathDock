<UserControl x:Class="PathDock.App.Views.AncestorColumnView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:PathDock.App.Localization"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:ctl="clr-namespace:PathDock.App.Controls"
             xmlns:vm="clr-namespace:PathDock.App.ViewModels">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <!-- 폴더 항목: 둥근 모서리, 선택 시 은은한 배경 + 왼쪽 강조 막대(기본 파란 선택색 대신 일관된 톤). -->
        <Style x:Key="AncestorItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Root" CornerRadius="2" Padding="{TemplateBinding Padding}" Background="Transparent"
                                BorderThickness="1" BorderBrush="Transparent">
                            <Grid>
                                <Border x:Name="Bar" Width="3" Height="14" CornerRadius="1" HorizontalAlignment="Left"
                                        Margin="-4,0,0,0" Visibility="Collapsed"
                                        Background="{DynamicResource SystemAccentColorPrimaryBrush}" />
                                <ContentPresenter Margin="6,0,0,0" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource SystemAccentColorPrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                                <Setter TargetName="Bar" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!-- Mdir 스타일 상위 폴더 열: 머리글=열 폴더 이름, 현재 경로가 지나는 항목이 선택 표시. DataContext: AncestorColumnViewModel -->
    <ctl:PanelCard Header="{Binding Title}" Symbol="FolderOpen24" ContentPadding="6">
        <ctl:PanelCard.ToolTip>
            <ToolTip FontFamily="{StaticResource PdFontFamily}" Content="{Binding FullPath}" />
        </ctl:PanelCard.ToolTip>
        <ctl:PanelCard.HeaderTrailing>
            <ui:Button Appearance="Transparent" Margin="4,-3,-6,-3" Padding="5,2"
                       Command="{Binding GoAboveCommand}"
                       ToolTip="{loc:T '가려진 위쪽 폴더로 올라가기', 'Go up to the hidden parent folder'}"
                       Visibility="{Binding HasHiddenAncestors, Converter={StaticResource BoolToVis}}"
                       AutomationProperties.Name="{loc:T '위쪽 폴더로 올라가기', 'Go up'}">
                <ui:SymbolIcon Symbol="ArrowUp24" FontSize="14" />
           </ui:Button>
        </ctl:PanelCard.HeaderTrailing>
        <Grid>
        <!-- 열이 비어 있을 때 이유를 알린다: 더 위가 없는 최상위(경로 없음) 또는 하위 폴더가 없음 -->
        <TextBlock FontSize="{DynamicResource PdFontSize}" Margin="10,8" TextWrapping="Wrap"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                   AutomationProperties.AutomationId="{Binding AutomationId, StringFormat={}{0}_Empty}">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Text" Value="{loc:T '하위 폴더 없음', 'No subfolders'}" />
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding FullPath}" Value="">
                            <Setter Property="Text" Value="{loc:T '더 위 폴더 없음(최상위)', 'No higher folder (top level)'}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding HasItems, ElementName=FolderList}" Value="False">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
        <ListBox x:Name="FolderList" ItemsSource="{Binding Items}" FontSize="{DynamicResource PdFontSize}"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                 ItemContainerStyle="{StaticResource AncestorItemStyle}"
                 Background="Transparent" BorderThickness="0"
                 AutomationProperties.AutomationId="{Binding AutomationId}"
                 AutomationProperties.Name="{Binding Title}">
            <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:AncestorItemViewModel}">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Folder24" FontSize="14" Margin="0,0,7,0" Filled="True"
                                       Foreground="#F0B429" />
                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        </Grid>
    </ctl:PanelCard>
</UserControl>
