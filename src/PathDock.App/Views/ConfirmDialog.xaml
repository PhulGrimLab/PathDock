<Window x:Class="PathDock.App.Views.ConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        FontFamily="{StaticResource PdFontFamily}"
        Width="440" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource ApplicationBackgroundBrush}"
        Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <!-- 예/아니오 확인 창. 시스템 메시지 상자 대신 앱 글꼴을 쓴다(\ 가 ₩ 로 보이지 않게). 기본 선택은 "아니오". -->
    <StackPanel Margin="20">
        <StackPanel Orientation="Horizontal">
            <ui:SymbolIcon Symbol="Warning24" FontSize="22" Margin="0,0,12,0" VerticalAlignment="Top"
                           Foreground="{DynamicResource SystemFillColorCautionBrush}" />
            <TextBlock x:Name="MessageText" TextWrapping="Wrap" MaxWidth="340" VerticalAlignment="Center"
                       AutomationProperties.AutomationId="ConfirmMessage" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <ui:Button Content="예" MinWidth="80" Margin="0,0,8,0" Click="Yes_Click"
                       AutomationProperties.AutomationId="ConfirmYes" />
            <ui:Button x:Name="NoButton" Content="아니요" Appearance="Primary" MinWidth="80" IsDefault="True" IsCancel="True"
                       AutomationProperties.AutomationId="ConfirmNo" />
        </StackPanel>
    </StackPanel>
</Window>
