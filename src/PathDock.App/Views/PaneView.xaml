<UserControl x:Class="PathDock.App.Views.PaneView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:PathDock.App.Localization"
             xmlns:ctl="clr-namespace:PathDock.App.Controls"
             xmlns:v="clr-namespace:PathDock.App.Views">
    <!--
        폴더 영역 한 칸: 위에 파란 전체 경로 탭(주소 표시줄), 아래에 [상위 폴더 열들 | 현재 폴더 목록].
        선택된 영역(IsActive)은 카드 바깥을 두르는 테두리(오버레이, 레이아웃 공간을 차지하지 않음)에 강조색을 입힌다. 그래서 카드의 좌우 끝이
        경로 탭의 좌우 끝과 정확히 맞고, 맨 윗줄에 놓인 경로 탭과도 폭·높이·아래 간격이 같다(MainWindow의 윗줄 탭은 이동 버튼 높이 38에 맞춘다).
        상위 열 개수는 AncestorColumns(0, 1, 3)로 정한다.
        DataContext: ExplorerViewModel
    -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ctl:AddressBar x:Name="PathTab" Grid.Row="0" Margin="0,0,0,8" MinHeight="38"
                        Text="{Binding PathText, Mode=TwoWay}"
                        Command="{Binding NavigatePathCommand}"
                        TextBoxAutomationId="{Binding AutomationSuffix, StringFormat=PathBar{0}}"
                        TextBoxAutomationName="{loc:T '현재 경로', 'Current path'}" />

        <Grid Grid.Row="1">
            <Grid x:Name="Columns">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="GreatColumn" />
                    <ColumnDefinition x:Name="GreatSplitColumn" />
                    <ColumnDefinition x:Name="GrandColumn" />
                    <ColumnDefinition x:Name="GrandSplitColumn" />
                    <ColumnDefinition x:Name="ParentColumn" />
                    <ColumnDefinition x:Name="ParentSplitColumn" />
                    <ColumnDefinition Width="*" MinWidth="200" />
                </Grid.ColumnDefinitions>
                <v:AncestorColumnView x:Name="GreatView" Grid.Column="0" DataContext="{Binding GreatGrandParent}" />
                <GridSplitter x:Name="GreatSplitter" Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="Transparent" Focusable="False" />
                <v:AncestorColumnView x:Name="GrandView" Grid.Column="2" DataContext="{Binding GrandParent}" />
                <GridSplitter x:Name="GrandSplitter" Grid.Column="3" Width="6" HorizontalAlignment="Stretch" Background="Transparent" Focusable="False" />
                <v:AncestorColumnView x:Name="ParentView" Grid.Column="4" DataContext="{Binding Parent}" />
                <GridSplitter x:Name="ParentSplitter" Grid.Column="5" Width="6" HorizontalAlignment="Stretch" Background="Transparent" Focusable="False" />
                <v:FileListView Grid.Column="6" />
            </Grid>
            <!-- 선택 표시: 카드에서 1px 띄워 바깥쪽에 3px 두께로 두른다(영역 사이 간격 6px 안에 들어옴). 마우스를 가로채지 않는다. -->
            <Border x:Name="Frame" Margin="-4" BorderThickness="3" CornerRadius="4" IsHitTestVisible="False">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="BorderBrush" Value="Transparent" />
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsActive}" Value="True" />
                                    <Condition Binding="{Binding HighlightActive, RelativeSource={RelativeSource AncestorType=v:PaneView}}" Value="True" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="BorderBrush" Value="{DynamicResource PdPaneActiveBrush}" />
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
            </Border>
        </Grid>
    </Grid>
</UserControl>
