<UserControl x:Class="PathDock.App.Views.NavButtonsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <!-- 이동 버튼 4개: 놓인 칸(드라이브 열) 폭을 균등하게 채운다. DataContext: ExplorerViewModel -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <ui:Button Grid.Column="0" Height="32" Margin="0,0,3,0" HorizontalAlignment="Stretch" Padding="0"
                   Icon="{ui:SymbolIcon ArrowLeft24}" Command="{Binding GoBackCommand}" ToolTip="뒤로"
                   AutomationProperties.AutomationId="BackButton" AutomationProperties.Name="뒤로" />
        <ui:Button Grid.Column="1" Height="32" Margin="3,0" HorizontalAlignment="Stretch" Padding="0"
                   Icon="{ui:SymbolIcon ArrowRight24}" Command="{Binding GoForwardCommand}" ToolTip="앞으로"
                   AutomationProperties.AutomationId="ForwardButton" AutomationProperties.Name="앞으로" />
        <ui:Button Grid.Column="2" Height="32" Margin="3,0" HorizontalAlignment="Stretch" Padding="0"
                   Icon="{ui:SymbolIcon ArrowUp24}" Command="{Binding GoUpCommand}" ToolTip="상위 폴더"
                   AutomationProperties.AutomationId="UpButton" AutomationProperties.Name="상위 폴더" />
        <ui:Button Grid.Column="3" Height="32" Margin="3,0,0,0" HorizontalAlignment="Stretch" Padding="0"
                   Icon="{ui:SymbolIcon ArrowClockwise24}" Command="{Binding RefreshCommand}"
                   ToolTip="새로 고침 (F5) - 폴더 크기도 다시 계산"
                   AutomationProperties.AutomationId="RefreshButton" AutomationProperties.Name="새로 고침" />
    </Grid>
</UserControl>
