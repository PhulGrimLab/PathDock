<Application x:Class="PathDock.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:system="clr-namespace:System;assembly=System.Runtime">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Dark" />
                <ui:ControlsDictionary />
            </ResourceDictionary.MergedDictionaries>

            <!-- 전역 모양 조정(병합된 WPF-UI 값보다 우선): 각진 모서리 + 한 단계 작은 기본 글꼴.
                 WPF-UI의 모든 컨트롤(버튼, 콤보, 진행 막대 등)이 이 값을 DynamicResource로 참조한다. -->
            <CornerRadius x:Key="ControlCornerRadius">2</CornerRadius>
            <CornerRadius x:Key="OverlayCornerRadius">2</CornerRadius>
            <system:Double x:Key="ControlContentThemeFontSize">12</system:Double>
        </ResourceDictionary>
    </Application.Resources>
</Application>
