<Application x:Class="PathDock.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:system="clr-namespace:System;assembly=System.Runtime">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Dark" />
                <ui:ControlsDictionary />
            </ResourceDictionary.MergedDictionaries>

            <!-- 전역 모양 조정(병합된 WPF-UI 값보다 우선): 각진 모서리 + 한 단계 작은 기본 글꼴.
                 WPF-UI의 모든 컨트롤(버튼, 콤보, 진행 막대 등)이 이 값을 DynamicResource로 참조한다. -->
            <CornerRadius x:Key="ControlCornerRadius">2</CornerRadius>
            <CornerRadius x:Key="OverlayCornerRadius">2</CornerRadius>
            <system:Double x:Key="ControlContentThemeFontSize">12</system:Double>
            <!-- 기본 글꼴: 한국어 Windows의 시스템 글꼴(맑은 고딕)은 역슬래시(\)를 원화(₩)로 그린다. 영문/기호는 Segoe UI, 한글은 맑은 고딕으로 대체해 터미널과 같은 \ 모양으로 통일한다. -->
            <FontFamily x:Key="PdFontFamily">Segoe UI, Malgun Gothic</FontFamily>
            <!-- 주소 표시줄 배경/테두리(슬레이트 블루). 기본값은 다크용이며 테마가 바뀌면 ThemeService가 갱신한다. -->
            <SolidColorBrush x:Key="PdAddressBarBackgroundBrush" Color="#1E2F45" />
            <SolidColorBrush x:Key="PdAddressBarBorderBrush" Color="#3B5A80" />
            <!-- 화면 글자 크기(설정 창에서 바꾸면 FontService가 이 값을 갱신) -->
            <system:Double x:Key="PdFontSize">12</system:Double>
            <system:Double x:Key="PdFontSizeSmall">11</system:Double>
            <system:Double x:Key="PdFontSizeLarge">14</system:Double>
        </ResourceDictionary>
    </Application.Resources>
</Application>
