<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- 다른 PC에서 Debug/Release 폴더만 복사해 실행할 수 있도록 .NET 런타임(WPF 네이티브 DLL, VC++ 런타임 포함)을 출력 폴더에 함께 넣는다. -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <!-- 출력 경로를 기존 그대로(bin\x64\Debug\net10.0-windows) 유지한다. -->
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <!-- 런타임이 싣고 오는 다국어 리소스 폴더(독일어, 일본어 등)는 빼고 한국어/영어만 둔다. -->
    <SatelliteResourceLanguages>ko;en</SatelliteResourceLanguages>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\PathDock.ico</ApplicationIcon>
    <AssemblyName>PathDock.App</AssemblyName>
    <RootNamespace>PathDock.App</RootNamespace>
    <Version>1.0.0</Version>
    <Product>PathDock</Product>
    <Company>PhulgrimLab</Company>
    <Copyright>© PhulgrimLab</Copyright>
    <Description>폴더 즐겨찾기, 파일 탐색기, 내장 터미널을 한 화면에 묶은 개발자용 작업 공간</Description>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="WPF-UI" Version="4.3.0" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Assets\PathDock.png" />
    <Resource Include="Assets\PathDock.ico" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\PathDock.Core\PathDock.Core.csproj" />
  </ItemGroup>
</Project>
