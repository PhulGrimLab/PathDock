<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Windows 10 2004(19041) 이상 API를 쓰기 위한 대상(PDF 미리보기에 내장 렌더러 Windows.Data.Pdf 사용). 앱은 이 버전 이상에서만 실행된다. -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- 다른 PC에서 Debug/Release 폴더만 복사해 실행할 수 있도록 .NET 런타임(WPF 네이티브 DLL, VC++ 런타임 포함)을 출력 폴더에 함께 넣는다. -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <!-- 출력 경로에 플랫폼/RID를 덧붙이지 않는다(bin\x64\Debug\net10.0-windows10.0.19041.0). -->
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <!-- 런타임이 싣고 오는 다국어 리소스 폴더(독일어, 일본어 등)는 빼고 한국어/영어만 둔다. -->
    <SatelliteResourceLanguages>ko;en</SatelliteResourceLanguages>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\PathDock.ico</ApplicationIcon>
    <AssemblyName>PathDock.App</AssemblyName>
    <RootNamespace>PathDock.App</RootNamespace>
    <Version>1.0.0</Version>
    <Product>PathDock</Product>
    <Company>PhulgrimLab</Company>
    <Copyright>© PhulgrimLab</Copyright>
    <Description>폴더 즐겨찾기, 파일 탐색기, 내장 터미널을 한 화면에 묶은 개발자용 작업 공간</Description>
  </PropertyGroup>
  <!-- 단일 파일 배포: Release 빌드가 끝나면 자동으로 publish까지 실행해 저장소 루트 publish\Release\ 에 exe 하나로 만든다.
       관리 DLL은 exe 안에 압축해 넣고, WPF 네이티브 DLL은 첫 실행 때 임시 폴더로 풀어 쓴다. Debug 빌드는 건너뛴다(느려서).
       끄려면 -p:PublishOnBuild=false. -->
  <PropertyGroup>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
    <PublishOnBuild Condition="'$(PublishOnBuild)' == ''">true</PublishOnBuild>
    <SingleFilePublishDir>$(MSBuildProjectDirectory)\..\..\publish\$(Configuration)\</SingleFilePublishDir>
  </PropertyGroup>
  <Target Name="PublishSingleFileAfterBuild" AfterTargets="Build"
          Condition="'$(Configuration)' == 'Release' and '$(PublishOnBuild)' == 'true' and '$(PdInnerPublish)' != 'true'">
    <MSBuild Projects="$(MSBuildProjectFullPath)" Targets="Publish" Properties="NoBuild=true;PdInnerPublish=true;PublishDir=$(SingleFilePublishDir)" />
  </Target>
  <ItemGroup>
    <PackageReference Include="WPF-UI" Version="4.3.0" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Assets\PathDock.png" />
    <Resource Include="Assets\PathDock.ico" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\PathDock.Core\PathDock.Core.csproj" />
  </ItemGroup>
</Project>
